# Copy to .env and adjust. Every value below is a LOCAL-ONLY sample; nothing here is a real secret.
# Defaults in packages/shared/src/config.ts are used for anything left out.

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL owns all durable state (events, deliveries, attempts, outbox, receiver tables).
# `pnpm infra:local` starts PostgreSQL on 5440 and Redis on 6390 without Docker.
DATABASE_URL=postgresql://lab:lab@127.0.0.1:5440/lab
# Only used by the integration tests / e2e stack to create throwaway databases.
TEST_DATABASE_ADMIN_URL=postgresql://lab:lab@127.0.0.1:5440/postgres

# Redis only carries BullMQ wake-up jobs; losing it never loses an event.
REDIS_URL=redis://127.0.0.1:6390
QUEUE_NAME=webhook-deliveries
QUEUE_PREFIX=lab

API_HOST=127.0.0.1
API_PORT=3000
RECEIVER_HOST=127.0.0.1
RECEIVER_PORT=3100
WORKER_HEALTH_PORT=3200

# The worker only sends to URLs on this allowlist (exact scheme/host/port + path prefix).
ALLOWED_RECEIVER_URLS=http://127.0.0.1:3100/webhooks/
# URL stored on the seeded endpoint; must match the allowlist.
RECEIVER_URL=http://127.0.0.1:3100/webhooks/receiver-fixture
# HMAC secret shared by sender and receiver fixture. Endpoints store the variable NAME, not the value.
RECEIVER_SECRET=local-dev-secret-change-me
# Token the API uses to read the receiver's diagnostics endpoint.
LAB_CONTROL_TOKEN=local-dev-control-token

WORKER_CONCURRENCY=4
LEASE_MS=15000
HTTP_TIMEOUT_HARD_CAP_MS=10000
DISPATCH_POLL_MS=250
DISPATCH_BATCH_SIZE=50
DISPATCH_GRACE_MS=30000
RECOVERY_POLL_MS=1000
SUPERVISOR_POLL_MS=500
RUN_TIMEOUT_MS=300000
STALLED_INTERVAL_MS=30000
