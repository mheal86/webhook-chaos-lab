{
  "name": "webhook-chaos-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Webhook Chaos Lab - fault-injection lab for webhook delivery, retry and recovery",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm --filter @lab/integration-tests test",
    "db:migrate": "pnpm --filter @lab/db migrate:deploy",
    "db:seed": "pnpm --filter @lab/db seed",
    "infra:local": "node scripts/local-infra.mjs",
    "e2e": "pnpm --filter @lab/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
